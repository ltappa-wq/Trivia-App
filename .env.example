# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- xAI question generation (required) ---
XAI_API_KEY=
# Optional — defaults to https://api.x.ai/v1
XAI_BASE_URL=
# Optional — defaults to grok-4.20-0309-non-reasoning
XAI_MODEL=

# --- Feedback email via Resend (optional) ---
RESEND_API_KEY=
# Optional — defaults to a resend.dev sandbox sender
RESEND_FROM=
# Optional — defaults to a hardcoded address in submitFeedback.ts
FEEDBACK_TO_EMAIL=

# --- Sentry error tracking (optional — unset runs dev/preview unchanged) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- E2E tests (optional, only needed to run the e2e suite) ---
E2E_BASE_URL=
